{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unified-text-editor",
  "main": "worker/index_tidio.js",
  "compatiblity_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "DOCX_UPLOADS",
      "bucket_name": "ravtext-docx-uploads"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ravtext-subscribers",
      "database_id": "57193d48-4241-4e4e-acd0-5168e9133bf3"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  }
}
