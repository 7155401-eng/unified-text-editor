{
  "$schema": "node_modules/wrangler/config-schema.jsonc",
  "name": "unified-text-editor",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ravtext-subscribers",
      "database_id": "57193d48-4241-4e4e-acd0-5168e9133bf3"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}

